#!/bin/bash

# DIP - Development Infrastructure Provisioner
# Complete local development environment setup with database, migrations, seeding, and testing

set -e

echo "=========================================="
echo "DIP - Development Infrastructure Provisioner"
echo "=========================================="
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Change to project root
cd "$(dirname "$0")"

echo "Step 1/8: Stopping existing Docker containers..."
cd infra/docker/compose
docker-compose -f docker-compose.dev.yml down -v
echo -e "${GREEN}✓ Containers stopped and volumes removed${NC}"
echo ""

echo "Step 2/8: Starting fresh Docker environment..."
docker-compose -f docker-compose.dev.yml up -d postgres redis
echo "Waiting for PostgreSQL to be ready..."
sleep 5
until docker-compose -f docker-compose.dev.yml exec -T postgres pg_isready -U digilist_dev > /dev/null 2>&1; do
  echo "Waiting for PostgreSQL..."
  sleep 2
done
echo -e "${GREEN}✓ PostgreSQL ready${NC}"
echo ""

echo "Step 3/8: Creating database schemas..."
docker-compose -f docker-compose.dev.yml exec -T postgres psql -U digilist_dev -d digilist_dev <<EOF
-- Create all required schemas
CREATE SCHEMA IF NOT EXISTS platform;
CREATE SCHEMA IF NOT EXISTS domain;
CREATE SCHEMA IF NOT EXISTS compliance;
CREATE SCHEMA IF NOT EXISTS monitoring;
CREATE SCHEMA IF NOT EXISTS saas;

-- Grant permissions
GRANT ALL ON SCHEMA platform TO digilist_dev;
GRANT ALL ON SCHEMA domain TO digilist_dev;
GRANT ALL ON SCHEMA compliance TO digilist_dev;
GRANT ALL ON SCHEMA monitoring TO digilist_dev;
GRANT ALL ON SCHEMA saas TO digilist_dev;

-- Verify schemas
\dn
EOF
echo -e "${GREEN}✓ Database schemas created${NC}"
echo ""

echo "Step 4/8: Running database migrations..."
cd ../../..
pnpm --filter @digilist/database-schema db:push
echo -e "${GREEN}✓ Migrations applied${NC}"
echo ""

echo "Step 5/8: Seeding database..."
pnpm --filter @digilist/database-schema seed || echo -e "${YELLOW}⚠ Seeding skipped (no seed script)${NC}"
echo ""

echo "Step 6/8: Starting all application containers..."
cd infra/docker/compose
docker-compose -f docker-compose.dev.yml up -d
echo "Waiting for applications to start..."
sleep 10
echo -e "${GREEN}✓ All containers started${NC}"
echo ""

echo "Step 7/8: Verifying services..."
cd ../../..

# Check PostgreSQL
if docker-compose -f infra/docker/compose/docker-compose.dev.yml exec -T postgres pg_isready -U digilist_dev > /dev/null 2>&1; then
  echo -e "${GREEN}✓ PostgreSQL: Running${NC}"
else
  echo -e "${RED}✗ PostgreSQL: Not responding${NC}"
fi

# Check Redis
if docker-compose -f infra/docker/compose/docker-compose.dev.yml exec -T redis redis-cli ping > /dev/null 2>&1; then
  echo -e "${GREEN}✓ Redis: Running${NC}"
else
  echo -e "${RED}✗ Redis: Not responding${NC}"
fi

# Check API
if curl -s http://localhost:4000/health > /dev/null 2>&1; then
  echo -e "${GREEN}✓ API: Running on http://localhost:4000${NC}"
else
  echo -e "${YELLOW}⚠ API: Starting... (check logs if not ready in 30s)${NC}"
fi

echo ""

echo "Step 8/8: Running tests..."
echo "Running unit tests..."
pnpm --filter @digilist/testing test:unit || echo -e "${YELLOW}⚠ Some unit tests failed${NC}"

echo ""
echo "Running integration tests..."
pnpm --filter @digilist/testing test:integration || echo -e "${YELLOW}⚠ Some integration tests failed${NC}"

echo ""
echo "=========================================="
echo -e "${GREEN}DIP Complete!${NC}"
echo "=========================================="
echo ""
echo "Service URLs:"
echo "  PostgreSQL:        localhost:5433"
echo "  Redis:             localhost:6380"
echo "  API:               http://localhost:4000"
echo "  Web:               http://localhost:5173"
echo "  MinSide:           http://localhost:5174"
echo "  Backoffice:        http://localhost:5175"
echo "  SaaS Admin:        http://localhost:5176"
echo "  Monitoring:        http://localhost:5177"
echo "  Docs & Learning:   http://localhost:5178"
echo "  Adminer (DB UI):   http://localhost:8080"
echo "  Redis Commander:   http://localhost:8081"
echo ""
echo "Useful commands:"
echo "  View logs:         docker-compose -f infra/docker/compose/docker-compose.dev.yml logs -f"
echo "  Stop all:          docker-compose -f infra/docker/compose/docker-compose.dev.yml down"
echo "  Run E2E tests:     pnpm --filter @digilist/testing test:e2e"
echo "  Database console:  docker-compose -f infra/docker/compose/docker-compose.dev.yml exec postgres psql -U digilist_dev -d digilist_dev"
echo ""
