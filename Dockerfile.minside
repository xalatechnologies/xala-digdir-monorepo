# Build stage for minside app
FROM node:22-alpine AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches/

# Copy all workspace package.json files
COPY apps/minside/package.json ./apps/minside/
COPY packages/ds/package.json ./packages/ds/
COPY packages/ds-themes/package.json ./packages/ds-themes/
COPY packages/runtime/package.json ./packages/runtime/
COPY packages/i18n/package.json ./packages/i18n/
COPY packages/eslint-config/package.json ./packages/eslint-config/

# Install dependencies (with patches applied)
RUN pnpm install --frozen-lockfile

# Copy source files
COPY . .

# Build the minside app
RUN pnpm -F @xala/minside build

# Production stage - serve static files with nginx
FROM nginx:alpine AS production

# Copy built assets
COPY --from=builder /app/apps/minside/dist /usr/share/nginx/html

# Copy custom nginx config for SPA routing
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ { \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
