{
  "name": "@digilist/api",
  "version": "1.0.0",
  "description": "Digilist Unified API - Contract-First, type-safe API powering all frontend apps",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --dts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "k6 run tests/performance/load-test.js",
    "test:perf:soak": "k6 run tests/performance/soak-test.js",
    "test:report": "vitest run --reporter=json --outputFile=test-results.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:validate": "tsx scripts/migrate.ts --validate",
    "db:seed": "node db/seed-data-bank/import-all.cjs",
    "db:seed:demo": "node db/seed-data-bank/import-all.cjs",
    "db:seed:v3": "node db/seed-data-bank/import-all.cjs",
    "db:reset": "pnpm db:push && pnpm db:seed",
    "test:rental-objects": "vitest run src/modules/rental-objects",
    "deploy": "bash scripts/deploy.sh production",
    "deploy:staging": "bash scripts/deploy.sh staging"
  },
  "dependencies": {
    "@digilist/database-schema": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@xala/contracts": "workspace:*",
    "drizzle-orm": "0.36.4",
    "fastify": "^5.0.0",
    "graphql": "^16.10.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mercurius": "^16.0.0",
    "pg": "^8.17.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "0.30.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
