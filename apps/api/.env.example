# Server Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/digilist_prod

# Redis (for session storage)
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://web.digilist.no,https://minside.digilist.no,https://backoffice.digilist.no

# ID-porten / BankID (Signicat)
IDPORTEN_BASE_URL=https://digilist.sandbox.signicat.com
IDPORTEN_API_URL=https://api.signicat.com
IDPORTEN_CALLBACK_URL=https://api.digilist.no/api/auth/idporten/callback
IDPORTEN_CLIENT_ID=your-client-id
IDPORTEN_CLIENT_SECRET=your-client-secret

# Cookies
COOKIE_DOMAIN=.digilist.no
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@digilist.no

# Feature Flags
FEATURE_DEMO_LOGIN=true
FEATURE_BANKID_LOGIN=true

# Logging
LOG_LEVEL=info
