# Unified API Environment Configuration
# Copy to .env and fill in actual values

# Database
DATABASE_URL=postgres://user:password@localhost:5432/unified_api

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Security
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# CORS (comma-separated origins)
CORS_ORIGINS=https://digilist.no,https://backoffice.digilist.no

# Logging
LOG_LEVEL=info

# Optional: External Services
# STRIPE_SECRET_KEY=sk_live_...
# REDIS_URL=redis://localhost:6379

# Signicat eID Hub (BankID)
SIGNICAT_CLIENT_ID=sandbox-fantastic-house-812
SIGNICAT_CLIENT_SECRET=your-client-secret
SIGNICAT_DOMAIN=sandbox-fantastic-house-812
SIGNICAT_REDIRECT_URI=http://localhost:4000/api/auth/signicat/callback
SIGNICAT_ACR_VALUES=idp:nbid
