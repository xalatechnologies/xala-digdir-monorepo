{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Seed Data Master Schema",
  "description": "Canonical JSON schemas for all seed data types in Digilist platform",
  "version": "1.0.0",
  
  "definitions": {
    "Tenant": {
      "type": "object",
      "required": ["id", "subdomain", "name", "status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "subdomain": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string"},
        "status": {"enum": ["active", "suspended", "trial"]},
        "isActive": {"type": "boolean", "default": true}
      }
    },
    
    "Organization": {
      "type": "object",
      "required": ["id", "tenantId", "name", "type"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "tenantId": {"type": "string", "format": "uuid"},
        "parentId": {"type": ["string", "null"], "format": "uuid"},
        "name": {"type": "string"},
        "type": {"enum": ["MUNICIPALITY", "CLUB", "NONPROFIT", "BUSINESS"]},
        "status": {"enum": ["active", "inactive"], "default": "active"}
      }
    },
    
    "User": {
      "type": "object",
      "required": ["id", "tenantId", "email", "name", "role"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "tenantId": {"type": "string", "format": "uuid"},
        "organizationId": {"type": "string", "format": "uuid"},
        "email": {"type": "string", "format": "email"},
        "name": {"type": "string"},
        "role": {"enum": ["admin", "manager", "staff", "member", "user"]},
        "status": {"enum": ["active", "inactive", "suspended"], "default": "active"},
        "demoToken": {"type": "string", "description": "For demo authentication"}
      }
    },
    
    "RentalObject": {
      "type": "object",
      "required": ["id", "tenantId", "organizationId", "name", "categoryKey", "type"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "tenantId": {"type": "string", "format": "uuid"},
        "organizationId": {"type": "string", "format": "uuid"},
        "name": {"type": "string"},
        "slug": {"type": "string"},
        "type": {"enum": ["SPACE", "EQUIPMENT", "VENUE"]},
        "categoryKey": {"type": "string"},
        "timeMode": {"enum": ["PERIOD", "HOURLY", "DAILY"], "default": "PERIOD"},
        "status": {"enum": ["draft", "published", "archived"], "default": "published"},
        "description": {"type": "string"},
        "capacity": {"type": "integer", "minimum": 1},
        "pricing": {"$ref": "#/definitions/Pricing"},
        "images": {
          "type": "array",
          "items": {"type": "string", "format": "uri"}
        },
        "metadata": {"$ref": "#/definitions/RentalObjectMetadata"}
      }
    },
    
    "Pricing": {
      "type": "object",
      "properties": {
        "basePrice": {"type": "number"},
        "currency": {"type": "string", "default": "NOK"},
        "unit": {"enum": ["hour", "day", "week", "month"]},
        "tiers": {
          "type": "array",
          "items": {"$ref": "#/definitions/PricingTier"}
        },
        "discounts": {
          "type": "array",
          "items": {"$ref": "#/definitions/Discount"}
        }
      }
    },
    
    "PricingTier": {
      "type": "object",
      "properties": {
        "type": {"enum": ["hourly", "half_day", "full_day", "weekly"]},
        "price": {"type": "number"},
        "duration": {"type": "number"},
        "label": {"type": "string"}
      }
    },
    
    "Discount": {
      "type": "object",
      "properties": {
        "type": {"enum": ["member", "student", "nonprofit", "early_bird"]},
        "percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "label": {"type": "string"}
      }
    },
    
    "RentalObjectMetadata": {
      "type": "object",
      "properties": {
        "location": {"$ref": "#/definitions/Location"},
        "contactName": {"type": "string"},
        "contactEmail": {"type": "string", "format": "email"},
        "contactPhone": {"type": "string"},
        "openingHours": {"$ref": "#/definitions/OpeningHours"},
        "amenities": {
          "type": "array",
          "items": {"type": "string"}
        },
        "regulations": {"$ref": "#/definitions/Regulations"},
        "bookingRules": {"$ref": "#/definitions/BookingRules"},
        "faq": {
          "type": "array",
          "items": {"$ref": "#/definitions/FAQItem"}
        },
        "rules": {
          "type": "array",
          "items": {"$ref": "#/definitions/Rule"}
        }
      }
    },
    
    "Location": {
      "type": "object",
      "required": ["address", "postalCode", "city", "country"],
      "properties": {
        "address": {"type": "string"},
        "postalCode": {"type": "string"},
        "city": {"type": "string"},
        "country": {"type": "string", "default": "Norway"}
      }
    },
    
    "OpeningHours": {
      "type": "object",
      "patternProperties": {
        "^(monday|tuesday|wednesday|thursday|friday|saturday|sunday|holidays)$": {
          "type": "object",
          "properties": {
            "open": {"type": "string", "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"},
            "close": {"type": "string", "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"}
          }
        }
      }
    },
    
    "Regulations": {
      "type": "object",
      "properties": {
        "age": {
          "type": "object",
          "properties": {
            "minimum": {"type": "integer"},
            "supervision": {"type": "string"}
          }
        },
        "insurance": {
          "type": "object",
          "properties": {
            "required": {"type": "boolean"},
            "minCoverage": {"type": "number"},
            "provider": {"type": "string"}
          }
        },
        "cancellation": {
          "type": "object",
          "properties": {
            "policy": {"type": "string"},
            "fee": {"type": "object"}
          }
        },
        "liability": {
          "type": "object",
          "properties": {
            "userResponsible": {"type": "boolean"},
            "deposit": {"type": "number"},
            "cleaningFee": {"type": "number"}
          }
        },
        "capacity": {
          "type": "object",
          "properties": {
            "maximum": {"type": "integer"},
            "fireCode": {"type": "string"}
          }
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "wheelchairAccess": {"type": "boolean"},
            "hearingLoop": {"type": "boolean"},
            "parking": {"type": "string"}
          }
        }
      }
    },
    
    "BookingRules": {
      "type": "object",
      "properties": {
        "advance": {
          "type": "object",
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"},
            "unit": {"type": "string"}
          }
        },
        "duration": {
          "type": "object",
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"},
            "unit": {"type": "string"}
          }
        },
        "recurring": {
          "type": "object",
          "properties": {
            "allowed": {"type": "boolean"},
            "maxWeeks": {"type": "integer"}
          }
        },
        "approval": {
          "type": "object",
          "properties": {
            "required": {"type": "boolean"},
            "autoApprove": {"type": "boolean"},
            "approvalTime": {"type": "number"}
          }
        }
      }
    },
    
    "FAQItem": {
      "type": "object",
      "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string"},
        "answer": {"type": "string"}
      }
    },
    
    "Rule": {
      "type": "object",
      "required": ["icon", "text"],
      "properties": {
        "icon": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    
    "Amenity": {
      "type": "object",
      "required": ["code", "name", "tenantId"],
      "properties": {
        "tenantId": {"type": "string", "format": "uuid"},
        "code": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "groupCode": {"type": "string"},
        "iconKey": {"type": "string"},
        "isActive": {"type": "boolean", "default": true}
      }
    },
    
    "AddOn": {
      "type": "object",
      "required": ["code", "name", "pricingModel", "basePriceCents", "tenantId"],
      "properties": {
        "tenantId": {"type": "string", "format": "uuid"},
        "code": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "pricingModel": {"enum": ["PER_BOOKING", "PER_HOUR", "PER_DAY", "PER_UNIT"]},
        "basePriceCents": {"type": "integer", "minimum": 0},
        "isRequired": {"type": "boolean", "default": false},
        "maxUnits": {"type": "integer", "minimum": 1},
        "isActive": {"type": "boolean", "default": true}
      }
    },
    
    "Booking": {
      "type": "object",
      "required": ["id", "tenantId", "rentalObjectId", "userId", "startTime", "endTime"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "tenantId": {"type": "string", "format": "uuid"},
        "rentalObjectId": {"type": "string", "format": "uuid"},
        "userId": {"type": "string", "format": "uuid"},
        "organizationId": {"type": "string", "format": "uuid"},
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"},
        "status": {"enum": ["PENDING", "CONFIRMED", "CANCELLED", "COMPLETED"], "default": "PENDING"},
        "bookingMode": {"enum": ["SINGLE", "RECURRING"], "default": "SINGLE"},
        "totalPriceCents": {"type": "integer"},
        "depositCents": {"type": "integer"},
        "paymentStatus": {"enum": ["PENDING", "PAID", "FAILED", "REFUNDED"]},
        "notes": {"type": "string"}
      }
    },
    
    "PricingGroup": {
      "type": "object",
      "required": ["tenantId", "code", "name", "discountPercentage"],
      "properties": {
        "tenantId": {"type": "string", "format": "uuid"},
        "code": {"type": "string", "pattern": "^[A-Z_]+$"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "discountPercentage": {"type": "number", "minimum": 0, "maximum": 100},
        "isActive": {"type": "boolean", "default": true},
        "requiresVerification": {"type": "boolean", "default": false},
        "verificationDocumentType": {"type": "string"}
      }
    },
    
    "OrganizationMember": {
      "type": "object",
      "required": ["tenantId", "organizationId", "userId", "role"],
      "properties": {
        "tenantId": {"type": "string", "format": "uuid"},
        "organizationId": {"type": "string", "format": "uuid"},
        "userId": {"type": "string", "format": "uuid"},
        "role": {"enum": ["OWNER", "ADMIN", "MANAGER", "MEMBER"]},
        "joinedAt": {"type": "string", "format": "date-time"},
        "isActive": {"type": "boolean", "default": true},
        "permissions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  
  "seedSchemas": {
    "tenants": {
      "type": "array",
      "items": {"$ref": "#/definitions/Tenant"}
    },
    "organizations": {
      "type": "array",
      "items": {"$ref": "#/definitions/Organization"}
    },
    "users": {
      "type": "array",
      "items": {"$ref": "#/definitions/User"}
    },
    "rentalObjects": {
      "type": "array",
      "items": {"$ref": "#/definitions/RentalObject"}
    },
    "amenities": {
      "type": "array",
      "items": {"$ref": "#/definitions/Amenity"}
    },
    "addons": {
      "type": "array",
      "items": {"$ref": "#/definitions/AddOn"}
    },
    "bookings": {
      "type": "array",
      "items": {"$ref": "#/definitions/Booking"}
    },
    "pricingGroups": {
      "type": "array",
      "items": {"$ref": "#/definitions/PricingGroup"}
    },
    "organizationMembers": {
      "type": "array",
      "items": {"$ref": "#/definitions/OrganizationMember"}
    }
  }
}
