{
  "name": "@xalatechnologies/platform-api",
  "version": "1.0.0",
  "description": "Platform API - Domain-agnostic API server for platform services",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --dts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@xalatechnologies/platform": "workspace:*",
    "@xalatechnologies/platform-schema": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.36.4",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
