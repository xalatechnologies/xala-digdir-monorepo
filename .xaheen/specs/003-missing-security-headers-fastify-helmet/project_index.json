{
  "project_type": "monorepo",
  "services": {
    "api": {
      "path": "./apps/api",
      "tech_stack": ["typescript", "fastify", "drizzle-orm", "postgres"],
      "port": 4000,
      "dev_command": "pnpm --filter @digilist/api dev",
      "test_command": "pnpm --filter @digilist/api test",
      "test_security_command": "pnpm --filter @digilist/api test:security",
      "build_command": "pnpm --filter @digilist/api build"
    },
    "web": {
      "path": "./apps/web",
      "tech_stack": ["typescript", "react", "vite"],
      "port": 5173,
      "dev_command": "pnpm --filter @digilist/web dev"
    },
    "backoffice": {
      "path": "./apps/backoffice",
      "tech_stack": ["typescript", "react", "vite"],
      "port": 5174,
      "dev_command": "pnpm --filter @digilist/backoffice dev"
    },
    "minside": {
      "path": "./apps/minside",
      "tech_stack": ["typescript", "react", "vite"],
      "port": 5175,
      "dev_command": "pnpm --filter @digilist/minside dev"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": "postgresql",
    "package_manager": "pnpm@9.15.0",
    "build_tool": "turborepo"
  },
  "conventions": {
    "linter": "eslint",
    "formatter": "prettier",
    "testing": "vitest",
    "e2e_testing": "playwright"
  }
}
