{
  "project_type": "monorepo",
  "services": {
    "minside": {
      "path": "apps/minside",
      "tech_stack": ["react", "typescript", "vite"],
      "port": 5174,
      "dev_command": "pnpm dev",
      "test_command": "vitest",
      "build_command": "pnpm build"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": "postgresql",
    "package_manager": "pnpm",
    "monorepo_tool": "turborepo"
  },
  "conventions": {
    "linter": "eslint",
    "formatter": "prettier",
    "testing": "vitest",
    "e2e_testing": "playwright",
    "design_system": "@xala/ds"
  }
}
