{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digilist.no/schemas/roadmap.schema.json",
  "title": "Digilist Roadmap Schema",
  "description": "JSON Schema for validating Digilist Platform roadmap documents",
  "type": "object",
  "$defs": {
    "phaseId": {
      "type": "string",
      "pattern": "^P[0-9]+$",
      "description": "Phase identifier (e.g., P0, P1, P2)"
    },
    "itemId": {
      "type": "string",
      "pattern": "^P[0-9]+-[0-9]{2}$",
      "description": "Item identifier combining phase ID with 2-digit number (e.g., P0-01, P1-02)"
    },
    "status": {
      "type": "string",
      "enum": ["DONE", "PARTIAL", "MISSING", "PLANNED"],
      "description": "Current implementation status of the roadmap item"
    },
    "priority": {
      "type": "string",
      "enum": ["MUST_HAVE", "SHOULD_HAVE", "NICE_TO_HAVE"],
      "description": "Priority level for the roadmap item"
    },
    "roadmapItem": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "description": "Human-readable title for the roadmap item"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the roadmap item"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "owner": {
          "type": "string",
          "description": "Team or person responsible for this item"
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "description": "Target completion date (ISO 8601 format)"
        },
        "ssaLClauses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SSA-L compliance clauses this item addresses"
        },
        "verificationRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Verification rule IDs for automated status checking"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/itemId"
          },
          "description": "List of item IDs this item depends on"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags/labels for categorization"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes or comments"
        }
      },
      "additionalProperties": false
    },
    "roadmapPhase": {
      "type": "object",
      "required": ["id", "name", "items"],
      "properties": {
        "id": {
          "$ref": "#/$defs/phaseId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name for the phase"
        },
        "description": {
          "type": "string",
          "description": "Description of the phase goals and scope"
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "Phase start date (ISO 8601 format)"
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "description": "Phase end date (ISO 8601 format)"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roadmapItem"
          },
          "minItems": 0,
          "description": "List of roadmap items in this phase"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["version", "title", "phases"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the roadmap document"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Title of the roadmap"
    },
    "description": {
      "type": "string",
      "description": "Overview description of the roadmap"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp (ISO 8601 format)"
    },
    "owner": {
      "type": "string",
      "description": "Organization or team owning this roadmap"
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roadmapPhase"
      },
      "minItems": 1,
      "description": "List of roadmap phases"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the roadmap",
      "properties": {
        "source": {
          "type": "string",
          "description": "Source system or origin of the roadmap"
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Export timestamp"
        },
        "schemaVersion": {
          "type": "string",
          "description": "Version of this schema"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
