      "sdk/http": [
        "./dist/sdk/http/index.d.ts"
      ],
      "sdk/errors": [
        "./dist/sdk/errors/index.d.ts"
      ],
      "sdk/query": [
        "./dist/sdk/query/index.d.ts"
      ],
      "sdk/retry": [
        "./dist/sdk/retry/index.d.ts"
      ],
      "ui/styles": [
        "./dist/ui/styles.d.ts"
      ],
      "ui/pages": [
        "./dist/ui/pages/index.d.ts"
      ],
      "ui/tokens": [
        "./dist/ui/tokens/index.d.ts"
      ],
      "i18n/locales": [
        "./dist/i18n/locales/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:boundaries": "node scripts/verify-boundaries.js",
    "verify:terms": "node scripts/verify-terms.js"
  },
  "keywords": [
    "xala",
    "xalatechnologies",
    "platform",
    "ui",
    "sdk",
    "react",
    "typescript",
    "designsystemet",
    "domain-agnostic"
  ],
  "author": "Xala Technologies",
  "license": "MIT",
  "dependencies": {
    "@digdir/designsystemet-react": "^1.9.0",
    "@tanstack/react-query": "^5.62.16",
    "js-cookie": "^3.0.5",
    "prom-client": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "^1.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  }
}
