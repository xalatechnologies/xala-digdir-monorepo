    "./i18n/locales": {
      "types": "./dist/i18n/locales/index.d.ts",
      "import": "./dist/i18n/locales/index.mjs",
      "require": "./dist/i18n/locales/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "./dist/ui/index.d.ts"
      ],
      "ui/primitives": [
        "./dist/ui/primitives/index.d.ts"
      ],
      "ui/composed": [
        "./dist/ui/composed/index.d.ts"
      ],
      "ui/shells": [
        "./dist/ui/shells/index.d.ts"
      ],
      "ui/blocks": [
        "./dist/ui/blocks/index.d.ts"
      ],
      "ui/themes": [
        "./dist/ui/themes/index.d.ts"
      ],
      "ui/patterns": [
        "./dist/ui/patterns/index.d.ts"
      ],
      "runtime": [
        "./dist/runtime/index.d.ts"
      ],
      "auth": [
        "./dist/auth/index.d.ts"
      ],
      "config": [
        "./dist/config/index.d.ts"
      ],
      "contracts": [
        "./dist/contracts/index.d.ts"
      ],
      "sdk": [
        "./dist/sdk/index.d.ts"
      ],
      "sdk/saas": [
        "./dist/sdk/saas/index.d.ts"
      ],
      "i18n": [
        "./dist/i18n/index.d.ts"
      ],
      "observability": [
        "./dist/observability/index.d.ts"
      ],
      "observability/metrics": [
        "./dist/observability/metrics/index.d.ts"
      ],
      "observability/exporters": [
        "./dist/observability/exporters/index.d.ts"
