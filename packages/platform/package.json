    "./sdk/errors": {
      "types": "./dist/sdk/errors/index.d.ts",
      "import": "./dist/sdk/errors/index.mjs",
      "require": "./dist/sdk/errors/index.js"
    },
    "./sdk/query": {
      "types": "./dist/sdk/query/index.d.ts",
      "import": "./dist/sdk/query/index.mjs",
      "require": "./dist/sdk/query/index.js"
