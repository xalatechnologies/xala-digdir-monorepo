      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.mjs",
      "require": "./dist/i18n/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.mjs",
      "require": "./dist/observability/index.js"
    },
    "./observability/metrics": {
      "types": "./dist/observability/metrics/index.d.ts",
      "import": "./dist/observability/metrics/index.mjs",
      "require": "./dist/observability/metrics/index.js"
