{
  "name": "@xalatechnologies/enterprise",
  "version": "1.0.0",
  "description": "Enterprise features for Xala/Digilist applications including feature flags, offline support, and tenant configuration",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/index.d.ts",
      "import": "./dist/feature-flags/index.mjs",
      "require": "./dist/feature-flags/index.js"
    },
    "./offline": {
      "types": "./dist/offline/index.d.ts",
      "import": "./dist/offline/index.mjs",
      "require": "./dist/offline/index.js"
    },
    "./tenant-config": {
      "types": "./dist/tenant-config/index.d.ts",
      "import": "./dist/tenant-config/index.mjs",
      "require": "./dist/tenant-config/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "enterprise",
    "feature-flags",
    "offline",
    "tenant-config",
    "xala",
    "digilist"
  ],
  "author": "Xala Technologies",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
