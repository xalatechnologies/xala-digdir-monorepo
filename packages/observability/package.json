{
  "name": "@xala/observability",
  "version": "1.0.0",
  "description": "Observability stack for Digilist platform - metrics, dashboards, alerts",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./metrics": "./src/metrics/index.ts",
    "./exporters": "./src/exporters/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "grafana:provision": "node scripts/provision-grafana.js",
    "prometheus:validate": "promtool check rules prometheus/rules/*.yml",
    "docker:up": "docker-compose -f docker-compose.observability.yml up -d",
    "docker:down": "docker-compose -f docker-compose.observability.yml down"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "observability",
    "monitoring",
    "metrics",
    "grafana",
    "prometheus",
    "alerting"
  ]
}
