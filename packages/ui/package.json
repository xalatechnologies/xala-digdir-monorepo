{
  "name": "@digilist/ui",
  "version": "1.0.0",
  "description": "Domain-specific UI components for the Digilist rental booking platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js"
    },
    "./features": {
      "types": "./dist/features/index.d.ts",
      "import": "./dist/features/index.js"
    },
    "./features/rental-objects": {
      "types": "./dist/features/rental-objects/index.d.ts",
      "import": "./dist/features/rental-objects/index.js"
    },
    "./features/booking": {
      "types": "./dist/features/booking/index.d.ts",
      "import": "./dist/features/booking/index.js"
    },
    "./features/seasons": {
      "types": "./dist/features/seasons/index.d.ts",
      "import": "./dist/features/seasons/index.js"
    },
    "./features/reviews": {
      "types": "./dist/features/reviews/index.d.ts",
      "import": "./dist/features/reviews/index.js"
    },
    "./features/rental-object-details": {
      "types": "./dist/features/rental-object-details/index.d.ts",
      "import": "./dist/features/rental-object-details/index.js"
    },
    "./rental-objects": {
      "types": "./dist/blocks/rental-objects/index.d.ts",
      "import": "./dist/blocks/rental-objects/index.js"
    },
    "./booking": {
      "types": "./dist/blocks/booking/index.d.ts",
      "import": "./dist/blocks/booking/index.js"
    },
    "./seasons": {
      "types": "./dist/blocks/seasons/index.d.ts",
      "import": "./dist/blocks/seasons/index.js"
    },
    "./booking-engine": {
      "types": "./dist/booking-engine/index.d.ts",
      "import": "./dist/booking-engine/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@digilist/contracts": "workspace:*",
    "@digdir/designsystemet-react": "^1.0.0-rc.1",
    "@xalatechnologies/platform": "file:../../../xala-platform/packages/platform"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "react-map-gl": "^7.0.0",
    "mapbox-gl": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react-map-gl": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "^1.0.0",
    "@fontsource/inter": "^5.0.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-docs": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/addon-viewport": "^8.6.0",
    "@storybook/manager-api": "^8.6.0",
    "@storybook/preview-api": "^8.6.0",
    "@storybook/theming": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.0",
    "@vueless/storybook-dark-mode": "^9.0.10",
    "storybook": "^8.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
