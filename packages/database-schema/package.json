{
  "name": "@digilist/database-schema",
  "version": "1.0.0",
  "description": "Drizzle ORM schemas for Digilist platform - single source of truth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js"
    },
    "./saas": {
      "types": "./dist/saas/index.d.ts",
      "import": "./dist/saas/index.js"
    },
    "./saas/entitlements": {
      "types": "./dist/saas/entitlements.d.ts",
      "import": "./dist/saas/entitlements.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed": "tsx seeds/import.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "0.30.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist"
  ]
}
