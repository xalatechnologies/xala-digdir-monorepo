{
  "name": "@xalatechnologies/platform-schema",
  "version": "1.0.0",
  "description": "Platform database schema - foundation tables for any SaaS application",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.cjs",
      "import": "./dist/core/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "require": "./dist/platform/index.cjs",
      "import": "./dist/platform/index.js"
    },
    "./saas": {
      "types": "./dist/saas/index.d.ts",
      "require": "./dist/saas/index.cjs",
      "import": "./dist/saas/index.js"
    },
    "./compliance": {
      "types": "./dist/compliance/index.d.ts",
      "require": "./dist/compliance/index.cjs",
      "import": "./dist/compliance/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "require": "./dist/schemas.cjs",
      "import": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "0.30.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "xala",
    "xalatechnologies",
    "platform",
    "database",
    "schema",
    "drizzle",
    "postgres"
  ],
  "author": "Xala Technologies",
  "license": "MIT"
}
