{
  "name": "@xala/ds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "default": "./src/styles.ts"
    },
    "./maps": {
      "default": "./src/maps.ts"
    }
  },
  "scripts": {
    "build": "echo 'DS package is source-only, consumed directly by bundlers'",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:test": "test-storybook",
    "docs:coverage": "node scripts/check-docs-coverage.js"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.0.0",
    "@digdir/designsystemet-react": "^1.9.0",
    "@digilist/client-sdk": "workspace:*",
    "@sentry/react": "^8.42.0",
    "@xala/auth": "workspace:*",
    "@xala/ds-themes": "workspace:*",
    "@xala/i18n": "workspace:*",
    "mapbox-gl": "^3.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.1.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.5.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-interactions": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/blocks": "^8.5.0",
    "@storybook/manager-api": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@storybook/test": "^8.5.0",
    "@storybook/test-runner": "^0.21.0",
    "@storybook/theming": "^8.5.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "storybook": "^8.5.0"
  }
}
