{
  "name": "@xala/contracts",
  "version": "1.0.0",
  "description": "Platform-level API contracts: Zod schemas for RFC7807, pagination, and common types",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.mjs",
      "require": "./dist/modules/index.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring/index.d.ts",
      "import": "./dist/monitoring/index.mjs",
      "require": "./dist/monitoring/index.js"
    },
    "./validation": {
      "types": "./dist/validation/env-schemas.d.ts",
      "import": "./dist/validation/env-schemas.mjs",
      "require": "./dist/validation/env-schemas.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "api",
    "contracts",
    "zod",
    "typescript",
    "rfc7807",
    "pagination"
  ],
  "author": "Xala Technologies",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^22.10.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
