{
  "name": "@xala/i18n",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && cp -r src/locales dist/",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:keys": "node ../../scripts/check-i18n-keys.js",
    "check:unused": "node ../../scripts/check-unused-keys.js"
  },
  "dependencies": {
    "js-cookie": "^3.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.18",
    "@xala/eslint-config": "workspace:*",
    "eslint": "^9.10.0",
    "jsdom": "^24.0.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.8"
  }
}
