{
  "name": "@xalatechnologies/governance",
  "version": "0.1.0",
  "description": "Governance tools: ESLint rules, testing utilities, and verification checks for the Xala platform",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing-e2e": {
      "types": "./dist/testing-e2e/index.d.ts",
      "import": "./dist/testing-e2e/index.js"
    },
    "./verification": {
      "types": "./dist/verification/index.d.ts",
      "import": "./dist/verification/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "verify:boundaries": "tsx src/verification/boundary-check.ts",
    "verify:terms": "tsx src/verification/term-check.ts",
    "verify": "pnpm verify:boundaries && pnpm verify:terms"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "keywords": [
    "eslint",
    "governance",
    "testing",
    "verification",
    "xala"
  ],
  "license": "UNLICENSED"
}
