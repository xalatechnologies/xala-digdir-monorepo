{
  "name": "@digilist/governance",
  "version": "1.0.0",
  "description": "ESLint rules and governance policies for Digilist platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "eslint",
    "governance",
    "design-system",
    "platform",
    "rules"
  ],
  "author": "Digilist",
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/utils": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  }
}
