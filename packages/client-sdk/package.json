{
  "name": "@digilist/client-sdk",
  "version": "1.1.0",
  "description": "Enterprise-grade type-safe SDK for the Digilist API with 24 services, WebSocket realtime, and React Query hooks",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.mjs",
      "require": "./dist/services/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@xala/contracts": "workspace:*",
    "@xala/sdk-core": "workspace:*",
    "browser-image-compression": "^2.0.2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.16",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@vitest/coverage-v8": "^3.0.4",
    "react": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "keywords": [
    "digilist",
    "xala",
    "sdk",
    "api-client",
    "react-query",
    "booking",
    "norwegian",
    "typescript"
  ],
  "author": "Xala Technologies <engineering@xalatechnologies.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xalatechnologies/xala-sdk.git",
    "directory": "src/client-sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
