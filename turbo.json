{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "*.{js,mjs,cjs}", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**/*.{ts,tsx}", "**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@digilist/database-schema#build": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.ts", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "@digilist/contracts#build": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.ts", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "@digilist/ui#build": {
      "dependsOn": ["@digilist/contracts#build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.{ts,tsx}", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "@digilist/client-sdk#build": {
      "dependsOn": ["@digilist/contracts#build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.{ts,tsx}", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "@digilist/runtime#build": {
      "dependsOn": ["@digilist/contracts#build", "@digilist/client-sdk#build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.{ts,tsx}", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "@digilist/platform-compat#build": {
      "dependsOn": ["@digilist/client-sdk#build", "@digilist/runtime#build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.{ts,tsx}", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "@digilist/ui#test": {
      "dependsOn": ["@digilist/ui#build"],
      "outputs": []
    },
    "@digilist/ui#lint": {
      "dependsOn": [],
      "outputs": []
    },
    "@digilist/web#build": {
      "dependsOn": ["@digilist/platform-compat#build", "@digilist/runtime#build", "@digilist/client-sdk#build", "@digilist/ui#build"],
      "outputs": ["dist/**"]
    },
    "@digilist/dashboard#build": {
      "dependsOn": ["@digilist/platform-compat#build", "@digilist/runtime#build", "@digilist/client-sdk#build", "@digilist/ui#build"],
      "outputs": ["dist/**"]
    },
    "@digilist/backoffice#build": {
      "dependsOn": ["@digilist/platform-compat#build", "@digilist/runtime#build", "@digilist/client-sdk#build", "@digilist/ui#build"],
      "outputs": ["dist/**"]
    },
    "@digilist/monitoring#build": {
      "dependsOn": ["@digilist/platform-compat#build", "@digilist/runtime#build", "@digilist/client-sdk#build", "@digilist/ui#build"],
      "outputs": ["dist/**"]
    },
    "@digilist/docs-learning#build": {
      "dependsOn": ["@digilist/platform-compat#build", "@digilist/runtime#build", "@digilist/client-sdk#build", "@digilist/ui#build"],
      "outputs": ["dist/**"]
    }
  }
}
