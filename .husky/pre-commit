#!/bin/sh

# i18n Pre-commit Hook
# Scans for hardcoded strings before allowing commits
# NOTE: nb.ts/en.ts parity check REMOVED - database is now SSOT for translations

echo "🌐 Running i18n pre-commit checks..."

# Skip legacy TS parity check - database is now source of truth
# The modular JSON files in packages/i18n/src/locales/nb/*.json are for seeding only


# ZERO-TOLERANCE: Scan staged frontend files for hardcoded strings
# Exclude translation locale files (they contain translation definitions by design)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(apps|packages)/.+\.(tsx?|jsx?)$' | grep -vE '(test|spec|mock|fixture|packages/i18n/src/locales/)' || true)

if [ -n "$STAGED_FILES" ]; then
  echo "🔍 Scanning staged files for hardcoded strings (ZERO-TOLERANCE)..."
  
  # Create temp file with staged files
  TEMP_FILE=$(mktemp)
  echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 -I {} echo "{}" > "$TEMP_FILE"
  
  # Run comprehensive scanner on staged files only
  for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
      node infra/scripts/legacy/scan-i18n-comprehensive.js "$FILE" 2>&1 | grep -q "Total Issues: 0"
      if [ $? -ne 0 ]; then
        echo "❌ Found hardcoded strings in: $FILE"
        echo "   Run: node infra/scripts/legacy/scan-i18n-comprehensive.js $FILE"
        echo "   Fix all issues before committing (ZERO-TOLERANCE POLICY)"
        rm "$TEMP_FILE"
        exit 1
      fi
    fi
  done
  
  rm "$TEMP_FILE"
  echo "✅ No hardcoded strings found in staged files!"
fi

# Architecture Quality Checks
echo "🏗️  Running architecture quality checks..."

# Check for CSS modules in apps
if git diff --cached --name-only | grep -E "^apps/.+\.module\.css$|^apps/.+\.css$" | grep -v node_modules; then
  echo "❌ ERROR: CSS modules not allowed in apps"
  echo "   Use @xala/ds tokens instead"
  echo "   See: docs/QUALITY/GAP_MATRIX.md"
  exit 1
fi

# Check for RBAC logic in apps
STAGED_APP_FILES=$(git diff --cached --name-only | grep -E "^apps/.+\.(ts|tsx)$" | grep -v test | grep -v node_modules || true)
if [ -n "$STAGED_APP_FILES" ]; then
  for FILE in $STAGED_APP_FILES; do
    if grep -q "ROLE_PERMISSIONS" "$FILE" 2>/dev/null; then
      echo "❌ ERROR: RBAC logic not allowed in apps: $FILE"
      echo "   Use capabilities API instead"
      echo "   See: docs/QUALITY/GAP_MATRIX.md section 3.1"
      exit 1
    fi
  done
fi

# Check for direct @digdir imports
if [ -n "$STAGED_APP_FILES" ]; then
  for FILE in $STAGED_APP_FILES; do
    if grep -q "from '@digdir/designsystemet-react'" "$FILE" 2>/dev/null; then
      echo "❌ ERROR: Direct @digdir imports not allowed: $FILE"
      echo "   Import from @xala/ds instead"
      exit 1
    fi
  done
fi

echo "✅ Architecture checks passed"

# Run lint-staged for other checks
npx lint-staged
