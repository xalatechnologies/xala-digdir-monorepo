{
  "$schema": "./rbac-matrix.schema.json",
  "role": "org_member",
  "displayName": "Organization Member",
  "description": "Basic org member with per-rental_object permissions",
  "level": 40,
  "inherits": ["user"],
  "scope": "organization",
  "capabilities": [
    {
      "id": "OM-DASH-VIEW",
      "action": "read",
      "resource": "dashboard",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "GET /api/dashboard",
      "sdkMethod": "useDashboard",
      "uiRoute": "/"
    },
    {
      "id": "OM-LIST-VIEW",
      "action": "read",
      "resource": "listings",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "GET /api/listings",
      "sdkMethod": "useListings",
      "uiRoute": "/listings"
    },
    {
      "id": "OM-LIST-CREATE",
      "action": "create",
      "resource": "listings",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "POST /api/listings",
      "sdkMethod": "useCreateListing",
      "uiRoute": "/listings/new"
    },
    {
      "id": "OM-BOOK-VIEW",
      "action": "read",
      "resource": "bookings",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "GET /api/organizations/:orgId/bookings",
      "sdkMethod": "useOrgBookings",
      "uiRoute": "/bookings"
    },
    {
      "id": "OM-BOOK-CREATE",
      "action": "create",
      "resource": "bookings",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "POST /api/organizations/:orgId/bookings",
      "sdkMethod": "useCreateBooking",
      "uiRoute": "/bookings/new"
    },
    {
      "id": "OM-BOOK-APPROVE",
      "action": "approve",
      "resource": "bookings",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "POST /api/bookings/:id/approve",
      "sdkMethod": "useApproveBooking",
      "uiRoute": "/work-queue"
    },
    {
      "id": "OM-BOOK-CANCEL-OWN",
      "action": "delete",
      "resource": "bookings",
      "scope": "own",
      "expected": "ALLOW",
      "endpoint": "DELETE /api/bookings/:id",
      "sdkMethod": "useCancelBooking",
      "uiRoute": "/bookings/:id",
      "constraint": "own_booking_only"
    },
    {
      "id": "OM-BOOK-CANCEL-OTHER",
      "action": "delete",
      "resource": "bookings",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "DELETE /api/bookings/:id",
      "sdkMethod": "useCancelBooking",
      "uiRoute": "/bookings/:id",
      "constraint": "other_user_booking"
    },
    {
      "id": "OM-MEMBER-VIEW",
      "action": "read",
      "resource": "members",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "GET /api/organizations/:orgId/members",
      "sdkMethod": "useOrgMembers",
      "uiRoute": "/org/members"
    },
    {
      "id": "OM-MEMBER-INVITE",
      "action": "create",
      "resource": "members",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "POST /api/organizations/:orgId/members/invite",
      "sdkMethod": "useInviteMember",
      "uiRoute": "/org/members"
    },
    {
      "id": "OM-MEMBER-REMOVE",
      "action": "delete",
      "resource": "members",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "DELETE /api/organizations/:orgId/members/:userId",
      "sdkMethod": "useRemoveMember",
      "uiRoute": "/org/members"
    },
    {
      "id": "OM-MEMBER-ROLE",
      "action": "update",
      "resource": "members",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "PATCH /api/organizations/:orgId/members/:userId",
      "sdkMethod": "useUpdateMemberRole",
      "uiRoute": "/org/members"
    },
    {
      "id": "OM-ORG-VIEW",
      "action": "read",
      "resource": "organization",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "GET /api/organizations/:orgId",
      "sdkMethod": "useOrganization",
      "uiRoute": "/org"
    },
    {
      "id": "OM-ORG-UPDATE",
      "action": "update",
      "resource": "organization",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "PATCH /api/organizations/:orgId",
      "sdkMethod": "useUpdateOrganization",
      "uiRoute": "/org/settings"
    },
    {
      "id": "OM-CAL-VIEW",
      "action": "read",
      "resource": "calendar",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "GET /api/calendar",
      "sdkMethod": "useCalendar",
      "uiRoute": "/calendar"
    },
    {
      "id": "OM-CAL-BLOCK",
      "action": "create",
      "resource": "blocks",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "POST /api/blocks",
      "sdkMethod": "useCreateBlock",
      "uiRoute": "/calendar"
    },
    {
      "id": "OM-MSG-VIEW",
      "action": "read",
      "resource": "messages",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "GET /api/messages",
      "sdkMethod": "useMessages",
      "uiRoute": "/messages",
      "featureFlag": "FEATURE_MESSAGING"
    },
    {
      "id": "OM-MSG-SEND",
      "action": "create",
      "resource": "messages",
      "scope": "org",
      "expected": "ALLOW",
      "endpoint": "POST /api/messages",
      "sdkMethod": "useSendMessage",
      "uiRoute": "/messages",
      "featureFlag": "FEATURE_MESSAGING"
    },
    {
      "id": "OM-REPORT-VIEW",
      "action": "read",
      "resource": "reports",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "GET /api/organizations/:orgId/reports",
      "sdkMethod": "useOrgReports",
      "uiRoute": "/reports"
    },
    {
      "id": "OM-REPORT-EXPORT",
      "action": "export",
      "resource": "reports",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "GET /api/organizations/:orgId/exports/:type",
      "sdkMethod": "useExport",
      "uiRoute": "/reports"
    },
    {
      "id": "OM-AUDIT-VIEW",
      "action": "read",
      "resource": "audit",
      "scope": "org",
      "expected": "DENY",
      "endpoint": "GET /api/organizations/:orgId/audit",
      "sdkMethod": "useOrgAudit",
      "uiRoute": "/org/audit"
    },
    {
      "id": "OM-SETTINGS-VIEW",
      "action": "read",
      "resource": "settings",
      "scope": "tenant",
      "expected": "DENY",
      "endpoint": "GET /api/settings",
      "sdkMethod": "useSettings",
      "uiRoute": "/settings"
    },
    {
      "id": "OM-USERS-MANAGE",
      "action": "manage",
      "resource": "users",
      "scope": "tenant",
      "expected": "DENY",
      "endpoint": "GET /api/users",
      "sdkMethod": "useUsers",
      "uiRoute": "/users"
    }
  ],
  "boundaryTests": [
    {
      "id": "OM-BOUNDARY-CROSS-ORG",
      "description": "Org A member cannot access Org B data",
      "expected": "403"
    },
    {
      "id": "OM-BOUNDARY-CROSS-TENANT",
      "description": "Cannot access different tenant",
      "expected": "403"
    },
    {
      "id": "OM-BOUNDARY-IDOR-BOOKING",
      "description": "Cannot read booking from different org",
      "expected": "403"
    },
    {
      "id": "OM-BOUNDARY-ENUM-ORGS",
      "description": "Cannot enumerate other organizations",
      "expected": "403"
    }
  ],
  "forbiddenRoutes": [
    "/org/members",
    "/org/settings",
    "/org/audit",
    "/work-queue",
    "/reports",
    "/settings",
    "/users"
  ],
  "auditRequirements": [
    "booking.create"
  ]
}
