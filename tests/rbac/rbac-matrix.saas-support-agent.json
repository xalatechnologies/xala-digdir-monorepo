{
  "$schema": "./rbac-matrix.schema.json",
  "role": "SAAS_SUPPORT_AGENT",
  "displayName": "SaaS Support Agent",
  "description": "Read-only support access to view tenants and audit logs for troubleshooting",
  "level": 60,
  "inherits": [],
  "scope": "platform",
  "capabilities": [
    {
      "id": "SSP-ME-VIEW",
      "action": "read",
      "resource": "saas:me",
      "scope": "platform",
      "expected": "ALLOW",
      "endpoint": "GET /api/saas/me",
      "sdkMethod": "useSaasMe",
      "uiRoute": "/"
    },
    {
      "id": "SSP-TENANT-LIST",
      "action": "read",
      "resource": "tenants",
      "scope": "platform",
      "expected": "ALLOW",
      "endpoint": "GET /api/saas/tenants",
      "sdkMethod": "useSaasTenants",
      "uiRoute": "/tenants"
    },
    {
      "id": "SSP-TENANT-READ",
      "action": "read",
      "resource": "tenant",
      "scope": "platform",
      "expected": "ALLOW",
      "endpoint": "GET /api/saas/tenants/:id",
      "sdkMethod": "useSaasTenant",
      "uiRoute": "/tenants/:id"
    },
    {
      "id": "SSP-TENANT-CREATE",
      "action": "create",
      "resource": "tenant",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "POST /api/saas/tenants",
      "sdkMethod": "useCreateSaasTenant",
      "uiRoute": "/tenants/new"
    },
    {
      "id": "SSP-TENANT-UPDATE",
      "action": "update",
      "resource": "tenant",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "PATCH /api/saas/tenants/:id",
      "sdkMethod": "useUpdateSaasTenant",
      "uiRoute": "/tenants/:id/edit"
    },
    {
      "id": "SSP-TENANT-SUSPEND",
      "action": "suspend",
      "resource": "tenant",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "POST /api/saas/tenants/:id/suspend",
      "sdkMethod": "useSuspendSaasTenant",
      "uiRoute": "/tenants/:id"
    },
    {
      "id": "SSP-LICENSE-ROTATE",
      "action": "rotate",
      "resource": "licenseKey",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "POST /api/saas/tenants/:id/rotate-license",
      "sdkMethod": "useRotateSaasLicenseKey",
      "uiRoute": "/tenants/:id"
    },
    {
      "id": "SSP-FLAGS-LIST",
      "action": "read",
      "resource": "featureFlags",
      "scope": "platform",
      "expected": "ALLOW",
      "endpoint": "GET /api/saas/feature-flags",
      "sdkMethod": "useSaasFeatureFlagsCatalog",
      "uiRoute": "/feature-flags"
    },
    {
      "id": "SSP-FLAGS-UPDATE",
      "action": "update",
      "resource": "tenantFlags",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "PUT /api/saas/tenants/:id/flags",
      "sdkMethod": "useUpdateSaasTenantFlags",
      "uiRoute": "/tenants/:id"
    },
    {
      "id": "SSP-BILLING-VIEW",
      "action": "read",
      "resource": "billing",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "GET /api/saas/billing",
      "sdkMethod": "useSaasBillingOverview",
      "uiRoute": "/billing"
    },
    {
      "id": "SSP-PLANS-LIST",
      "action": "read",
      "resource": "plans",
      "scope": "platform",
      "expected": "ALLOW",
      "endpoint": "GET /api/saas/plans",
      "sdkMethod": "useSaasPlans",
      "uiRoute": "/plans"
    },
    {
      "id": "SSP-PLANS-CREATE",
      "action": "create",
      "resource": "plan",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "POST /api/saas/plans",
      "sdkMethod": "useCreateSaasPlan",
      "uiRoute": "/plans/new"
    },
    {
      "id": "SSP-PLAN-ASSIGN",
      "action": "assign",
      "resource": "tenantPlan",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "PUT /api/saas/tenants/:id/plan",
      "sdkMethod": "useAssignSaasPlan",
      "uiRoute": "/tenants/:id"
    },
    {
      "id": "SSP-SECRETS-VIEW",
      "action": "read",
      "resource": "secrets",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "GET /api/saas/tenants/:id/secrets",
      "sdkMethod": "useSaasTenantSecrets",
      "uiRoute": "/tenants/:id"
    },
    {
      "id": "SSP-SEEDS-EXECUTE",
      "action": "execute",
      "resource": "seeds",
      "scope": "platform",
      "expected": "DENY",
      "endpoint": "POST /api/admin/seed-import",
      "sdkMethod": "useExecuteSeed",
      "uiRoute": "/seed-data"
    },
    {
      "id": "SSP-AUDIT-VIEW",
      "action": "read",
      "resource": "audit",
      "scope": "platform",
      "expected": "ALLOW",
      "endpoint": "GET /api/saas/audit",
      "sdkMethod": "useSaasAudit",
      "uiRoute": "/audit"
    }
  ],
  "boundaryTests": [
    {
      "id": "SSP-BOUNDARY-TENANT-MODIFY",
      "description": "Support agent cannot create/update/suspend tenants",
      "expected": "403"
    },
    {
      "id": "SSP-BOUNDARY-BILLING",
      "description": "Support agent cannot access billing data",
      "expected": "403"
    },
    {
      "id": "SSP-BOUNDARY-SECRETS",
      "description": "Support agent cannot view secrets",
      "expected": "403"
    },
    {
      "id": "SSP-BOUNDARY-LICENSE",
      "description": "Support agent cannot rotate license keys",
      "expected": "403"
    }
  ],
  "auditRequirements": []
}
