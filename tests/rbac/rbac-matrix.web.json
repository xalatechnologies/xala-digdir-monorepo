{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web RBAC Matrix",
  "description": "Role × Capability × Scope matrix for Web app",
  "version": "1.0.0",
  "generated": "2026-01-18",
  
  "roles": {
    "anonymous": {
      "description": "Unauthenticated visitor",
      "context": null
    },
    "authenticated_user": {
      "description": "Logged in user",
      "context": "self"
    }
  },
  
  "capabilities": {
    "CAP_LISTING_BROWSE": {
      "description": "Browse listings (public)",
      "endpoint": "GET /listings",
      "roles": ["anonymous", "authenticated_user"],
      "scope": "global"
    },
    "CAP_LISTING_VIEW": {
      "description": "View listing details (public)",
      "endpoint": "GET /listings/:id",
      "roles": ["anonymous", "authenticated_user"],
      "scope": "global"
    },
    "CAP_LISTING_AVAILABILITY": {
      "description": "View availability calendar",
      "endpoint": "GET /listings/:id/availability",
      "roles": ["anonymous", "authenticated_user"],
      "scope": "global"
    },
    "CAP_BOOKING_PREVIEW": {
      "description": "Preview booking price",
      "endpoint": "POST /pricing/preview",
      "roles": ["anonymous", "authenticated_user"],
      "scope": "global"
    },
    "CAP_BOOKING_CREATE": {
      "description": "Create a booking",
      "endpoint": "POST /bookings",
      "roles": ["authenticated_user"],
      "scope": "self"
    },
    "CAP_BOOKING_RESERVE": {
      "description": "Reserve slot (in-game mode)",
      "endpoint": "POST /bookings/reserve",
      "roles": ["authenticated_user"],
      "scope": "self"
    },
    "CAP_BOOKING_RECURRING_PREVIEW": {
      "description": "Preview recurring booking",
      "endpoint": "POST /bookings/recurring-preview",
      "roles": ["authenticated_user"],
      "scope": "self"
    },
    "CAP_PAYMENT_INIT": {
      "description": "Initialize payment",
      "endpoint": "POST /payments/init",
      "roles": ["authenticated_user"],
      "scope": "self"
    },
    "CAP_FAVORITE_ADD": {
      "description": "Add to favorites",
      "endpoint": "POST /me/favorites/:id",
      "roles": ["authenticated_user"],
      "scope": "self"
    },
    "CAP_FAVORITE_REMOVE": {
      "description": "Remove from favorites",
      "endpoint": "DELETE /me/favorites/:id",
      "roles": ["authenticated_user"],
      "scope": "self"
    }
  },
  
  "routes": {
    "/": {
      "capability": "CAP_LISTING_BROWSE",
      "auth": false
    },
    "/listings": {
      "capability": "CAP_LISTING_BROWSE",
      "auth": false
    },
    "/listings/:id": {
      "capability": "CAP_LISTING_VIEW",
      "auth": false
    },
    "/login": {
      "capability": null,
      "auth": false
    },
    "/privacy-settings": {
      "capability": null,
      "auth": false
    },
    "/payment/callback": {
      "capability": "CAP_PAYMENT_INIT",
      "auth": true
    }
  },
  
  "authBoundaries": {
    "booking_creation": {
      "description": "Creating a booking requires authentication",
      "triggerAction": "click_confirm_booking",
      "redirectTo": "/login",
      "returnTo": "booking_wizard_step"
    },
    "favorite_action": {
      "description": "Adding favorites requires authentication",
      "triggerAction": "click_favorite",
      "redirectTo": "/login",
      "returnTo": "listing_page"
    }
  },
  
  "testCases": {
    "positive": [
      {
        "id": "anon_browse_listings",
        "role": "anonymous",
        "action": "GET /listings",
        "expected": 200
      },
      {
        "id": "anon_view_listing",
        "role": "anonymous",
        "action": "GET /listings/:id",
        "expected": 200
      },
      {
        "id": "anon_view_availability",
        "role": "anonymous",
        "action": "GET /listings/:id/availability",
        "expected": 200
      },
      {
        "id": "anon_preview_price",
        "role": "anonymous",
        "action": "POST /pricing/preview",
        "expected": 200
      },
      {
        "id": "auth_create_booking",
        "role": "authenticated_user",
        "action": "POST /bookings",
        "expected": 201
      },
      {
        "id": "auth_add_favorite",
        "role": "authenticated_user",
        "action": "POST /me/favorites/:id",
        "expected": 201
      }
    ],
    "negative": [
      {
        "id": "anon_cannot_create_booking",
        "role": "anonymous",
        "action": "POST /bookings",
        "expected": 401,
        "reason": "Booking requires authentication"
      },
      {
        "id": "anon_cannot_reserve_slot",
        "role": "anonymous",
        "action": "POST /bookings/reserve",
        "expected": 401,
        "reason": "Reservation requires authentication"
      },
      {
        "id": "anon_cannot_init_payment",
        "role": "anonymous",
        "action": "POST /payments/init",
        "expected": 401,
        "reason": "Payment requires authentication"
      },
      {
        "id": "anon_cannot_add_favorite",
        "role": "anonymous",
        "action": "POST /me/favorites/:id",
        "expected": 401,
        "reason": "Favorites require authentication"
      }
    ],
    "validation": [
      {
        "id": "booking_invalid_slot",
        "role": "authenticated_user",
        "action": "POST /bookings",
        "payload": { "slotId": "occupied-slot" },
        "expected": 409,
        "reason": "Cannot book occupied slot"
      },
      {
        "id": "booking_invalid_date",
        "role": "authenticated_user",
        "action": "POST /bookings",
        "payload": { "date": "1999-01-01" },
        "expected": 400,
        "reason": "Cannot book past date"
      },
      {
        "id": "booking_blackout_date",
        "role": "authenticated_user",
        "action": "POST /bookings",
        "payload": { "date": "blackout-date" },
        "expected": 409,
        "reason": "Cannot book blackout date"
      }
    ]
  },
  
  "calendarSlotStates": {
    "available": {
      "color": "green",
      "bookable": true,
      "displayText": "Ledig"
    },
    "reserved": {
      "color": "yellow",
      "bookable": false,
      "displayText": "Reservert"
    },
    "occupied": {
      "color": "red",
      "bookable": false,
      "displayText": "Opptatt"
    },
    "blackout": {
      "color": "gray",
      "bookable": false,
      "displayText": "Stengt"
    },
    "disabled": {
      "color": "striped",
      "bookable": false,
      "displayText": "Ikke tilgjengelig"
    },
    "selected": {
      "color": "blue",
      "bookable": true,
      "displayText": "Valgt"
    }
  },
  
  "bookingModes": {
    "SINGLE_SLOT": {
      "description": "Single slot booking",
      "steps": ["select", "review", "auth", "pay", "confirm"],
      "timeout": null
    },
    "IN_GAME": {
      "description": "Real-time reservation with TTL",
      "steps": ["select", "reserve", "review", "auth", "pay", "confirm"],
      "timeout": 300,
      "expiryBehavior": "release_with_warning"
    },
    "RECURRING": {
      "description": "Recurring pattern booking",
      "steps": ["pattern", "preview_conflicts", "review", "auth", "pay", "confirm"],
      "timeout": null
    }
  }
}
