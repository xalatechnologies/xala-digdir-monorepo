# ==============================================================================
# DIGILIST PLATFORM - TEST ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.test and fill in the values
# NEVER commit .env.test to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=digilist_test
POSTGRES_PASSWORD=CHANGE_ME_STRONG_TEST_PASSWORD
POSTGRES_DB=digilist_test

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# Security Secrets (MUST BE STRONG AND UNIQUE)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_STRONG_REFRESH_SECRET
CSRF_SECRET=CHANGE_ME_GENERATE_STRONG_CSRF_SECRET
SESSION_SECRET=CHANGE_ME_GENERATE_STRONG_SESSION_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS Configuration (Test Environment URLs - ONLY test subdomains)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://72.61.23.56:8080,http://72.61.23.56:8081,http://72.61.23.56:8082,http://72.61.23.56:8083,http://72.61.23.56:8084

# NOTE: Using IP:PORT for test environment
# Production domains (digilist.no) are NOT touched
# Test subdomains will be configured via reverse proxy:
#   - backoffice-test.digilist.no -> 72.61.23.56:8082
#   - minside-test.digilist.no -> 72.61.23.56:8081
#   - web-test.digilist.no -> 72.61.23.56:8080

# ------------------------------------------------------------------------------
# Monitoring & Error Tracking
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-test-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=test
SENTRY_RELEASE=

# ------------------------------------------------------------------------------
# ID-porten (BankID) - SANDBOX/TEST
# ------------------------------------------------------------------------------
IDPORTEN_CLIENT_ID=
IDPORTEN_CLIENT_SECRET=
IDPORTEN_BASE_URL=https://login.test.idporten.no
IDPORTEN_CALLBACK_URL=http://72.61.23.56:4000/api/auth/idporten/callback

# ------------------------------------------------------------------------------
# Vipps - TEST
# ------------------------------------------------------------------------------
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_ENVIRONMENT=test

# ------------------------------------------------------------------------------
# Email Service (SendGrid) - TEST
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=test@digilist.no
EMAIL_FROM_NAME=Digilist Test

# ------------------------------------------------------------------------------
# File Storage (AWS S3) - TEST
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=digilist-test

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# ==============================================================================
# TEST ENVIRONMENT URLS
# ==============================================================================
# IMPORTANT: Test environment uses IP:PORT access initially
# Production domain (digilist.no) is NOT affected by test deployment
#
# Direct Access (IP:PORT):
# - Web:          http://72.61.23.56:8080
# - MinSide:      http://72.61.23.56:8081
# - Backoffice:   http://72.61.23.56:8082
# - Tenant Admin: http://72.61.23.56:8083
# - SaaS Admin:   http://72.61.23.56:8084
# - Monitoring:   http://72.61.23.56:8085
# - Docs:         http://72.61.23.56:8086
# - API:          http://72.61.23.56:4000
#
# Optional: Configure reverse proxy (Nginx/Caddy) for subdomains:
# - web-test.digilist.no -> 72.61.23.56:8080
# - minside-test.digilist.no -> 72.61.23.56:8081
# - backoffice-test.digilist.no -> 72.61.23.56:8082
# ==============================================================================
