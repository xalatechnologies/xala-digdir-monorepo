# ==============================================================================
# DIGILIST PLATFORM - TEST ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.test and fill in the values
# NEVER commit .env.test to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=digilist_test
POSTGRES_PASSWORD=CHANGE_ME_STRONG_TEST_PASSWORD
POSTGRES_DB=digilist_test

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# Security Secrets (MUST BE STRONG AND UNIQUE)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_STRONG_REFRESH_SECRET
CSRF_SECRET=CHANGE_ME_GENERATE_STRONG_CSRF_SECRET
SESSION_SECRET=CHANGE_ME_GENERATE_STRONG_SESSION_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS Configuration (Test Environment URLs)
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://web-test.digilist.no,https://minside-test.digilist.no,https://backoffice-test.digilist.no,https://tenant-admin-test.digilist.no,https://saas-admin-test.digilist.no

# ------------------------------------------------------------------------------
# Monitoring & Error Tracking
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-test-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=test
SENTRY_RELEASE=

# ------------------------------------------------------------------------------
# ID-porten (BankID) - SANDBOX/TEST
# ------------------------------------------------------------------------------
IDPORTEN_CLIENT_ID=
IDPORTEN_CLIENT_SECRET=
IDPORTEN_BASE_URL=https://login.test.idporten.no
IDPORTEN_CALLBACK_URL=https://api-test.digilist.no/api/auth/idporten/callback

# ------------------------------------------------------------------------------
# Vipps - TEST
# ------------------------------------------------------------------------------
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_ENVIRONMENT=test

# ------------------------------------------------------------------------------
# Email Service (SendGrid) - TEST
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=test@digilist.no
EMAIL_FROM_NAME=Digilist Test

# ------------------------------------------------------------------------------
# File Storage (AWS S3) - TEST
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=digilist-test

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# ==============================================================================
# TEST ENVIRONMENT URLS
# ==============================================================================
# Frontend Applications:
# - Web:        https://web-test.digilist.no
# - MinSide:    https://minside-test.digilist.no
# - Backoffice: https://backoffice-test.digilist.no
# - Tenant Admin: https://tenant-admin-test.digilist.no
# - SaaS Admin: https://saas-admin-test.digilist.no
# - Monitoring: https://monitoring-test.digilist.no
# - Docs:       https://docs-test.digilist.no
#
# Backend API:
# - API:        https://api-test.digilist.no
# ==============================================================================
