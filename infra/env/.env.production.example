# ==============================================================================
# DIGILIST PLATFORM - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=digilist_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD
POSTGRES_DB=digilist_prod

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# Security Secrets (MUST BE STRONG AND UNIQUE)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_STRONG_REFRESH_SECRET
CSRF_SECRET=CHANGE_ME_GENERATE_STRONG_CSRF_SECRET
SESSION_SECRET=CHANGE_ME_GENERATE_STRONG_SESSION_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS Configuration (Production Domains Only)
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://digilist.no,https://minside.digilist.no,https://backoffice.digilist.no,https://admin.digilist.no

# ------------------------------------------------------------------------------
# Monitoring & Error Tracking
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# ------------------------------------------------------------------------------
# ID-porten (BankID) - PRODUCTION
# ------------------------------------------------------------------------------
IDPORTEN_CLIENT_ID=
IDPORTEN_CLIENT_SECRET=
IDPORTEN_BASE_URL=https://login.idporten.no
IDPORTEN_CALLBACK_URL=https://api.digilist.no/api/auth/idporten/callback

# ------------------------------------------------------------------------------
# Vipps - PRODUCTION
# ------------------------------------------------------------------------------
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Email Service (SendGrid) - PRODUCTION
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=noreply@digilist.no
EMAIL_FROM_NAME=Digilist

# ------------------------------------------------------------------------------
# File Storage (AWS S3) - PRODUCTION
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=digilist-production

# ------------------------------------------------------------------------------
# Rate Limiting (Stricter in Production)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Logging (Production Level)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ==============================================================================
# SECURITY CHECKLIST
# ==============================================================================
# Before deploying to production, ensure:
# [ ] All secrets are strong and unique (use openssl rand -base64 32)
# [ ] Database password is complex (min 32 characters)
# [ ] Redis password is set
# [ ] CORS origins are restricted to production domains only
# [ ] Sentry DSN is configured for production project
# [ ] ID-porten uses production credentials
# [ ] Vipps uses production credentials
# [ ] SendGrid uses production API key
# [ ] AWS credentials have minimal required permissions
# [ ] SSL certificates are configured
# [ ] Firewall rules are in place
# [ ] Backup strategy is implemented
# [ ] Monitoring and alerting are configured
# ==============================================================================
