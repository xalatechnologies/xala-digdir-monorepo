version: '3.8'

services:
  # PostgreSQL Database
  postgres:
    image: postgres:16
    container_name: digilist-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: digilist
      POSTGRES_PASSWORD: digilist_secure_2026
      POSTGRES_DB: digilist_prod
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U digilist -d digilist_prod"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis (for sessions and queues)
  redis:
    image: redis:7-alpine
    container_name: digilist-redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # API Server
  api:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    container_name: digilist-api
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3001/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Web App (Public)
  web:
    image: nginx:alpine
    container_name: digilist-web
    restart: unless-stopped
    ports:
      - "8080:80"
    volumes:
      - ./apps/web/dist:/usr/share/nginx/html:ro
      - ./docker/nginx/web.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Backoffice App
  backoffice:
    image: nginx:alpine
    container_name: digilist-backoffice
    restart: unless-stopped
    ports:
      - "8081:80"
    volumes:
      - ./apps/backoffice/dist:/usr/share/nginx/html:ro
      - ./docker/nginx/backoffice.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Min Side App
  minside:
    image: nginx:alpine
    container_name: digilist-minside
    restart: unless-stopped
    ports:
      - "8082:80"
    volumes:
      - ./apps/minside/dist:/usr/share/nginx/html:ro
      - ./docker/nginx/minside.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost"]
      interval: 30s
      timeout: 10s
      retries: 3

  # SaaS Admin App
  saas-admin:
    image: nginx:alpine
    container_name: digilist-saas-admin
    restart: unless-stopped
    ports:
      - "8083:80"
    volumes:
      - ./apps/saas-admin/dist:/usr/share/nginx/html:ro
      - ./docker/nginx/saas-admin.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Tenant Admin App
  tenant-admin:
    image: nginx:alpine
    container_name: digilist-tenant-admin
    restart: unless-stopped
    ports:
      - "8084:80"
    volumes:
      - ./apps/tenant-admin/dist:/usr/share/nginx/html:ro
      - ./docker/nginx/tenant-admin.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost"]
      interval: 30s
      timeout: 10s
      retries: 3

volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local

networks:
  default:
    name: digilist-network
