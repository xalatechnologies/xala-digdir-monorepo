          { code: 'SELECT_SLOT', labelKey: 'calendar.action.selectSlot', enabled: true },
          { code: 'REQUEST_BOOKING', labelKey: 'calendar.action.requestBooking', enabled: true },
        ] : [],
      },
    };
  });

