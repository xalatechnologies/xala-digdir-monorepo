      status: 'confirmed',
    } as CalendarEvent,
    {
      id: 'event-3',
      listingId: 'listing-2',
      startTime: new Date('2026-01-14T11:00:00'),
      endTime: new Date('2026-01-14T13:00:00'),
      title: 'Event 3',
      status: 'confirmed',
