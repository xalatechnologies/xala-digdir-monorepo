      const revokedGrant = {
        id: testGrantId,
        status: 'REVOKED',
        revokedAt: new Date().toISOString(),
      };

      expect(revokedGrant.status).toBe('REVOKED');
      expect(revokedGrant.revokedAt).toBeDefined();
