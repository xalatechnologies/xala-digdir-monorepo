    const mouseLeave = {
      currentTarget: {
        getBoundingClientRect: () => ({ top: 0 }),
        dataset: { date: '2026-01-14' },
      },
      target: {
        getBoundingClientRect: () => ({ top: 0 }),
        dataset: { date: '2026-01-14' },
      },
    } as any;
    // Make currentTarget === target
    mouseLeave.target = mouseLeave.currentTarget;

    act(() => {
