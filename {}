describe('useConflictDetection', () => {
  const mockEvents: CalendarEvent[] = [
    {
      id: 'event-1',
      listingId: 'listing-1',
      startTime: new Date('2026-01-14T10:00:00'),
      endTime: new Date('2026-01-14T12:00:00'),
      title: 'Event 1',
