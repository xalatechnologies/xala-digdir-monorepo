  it('should cancel drag on mouse leave', () => {
    const { result } = renderHook(() => useDragAndDrop());

    const mouseDown = {
      currentTarget: {
        getBoundingClientRect: () => ({ top: 0 }),
        dataset: { date: '2026-01-14' },
