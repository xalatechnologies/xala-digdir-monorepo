// Mock Fastify reply with captured state
class MockReply {
  sentData: any = null;
  sentStatus: number = 200;

  status(code: number) {
    this.sentStatus = code;
    return this;
  }

  async send(data: any) {
    this.sentData = data;
    return this;
  }
}

function createMockReply() {
  const mock = new MockReply();
  return {
    reply: mock as any as FastifyReply,
    mock,
  };
}

