{
  "name": "xala-digdir-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier -w .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:playwright": "playwright test",
    "test:e2e:auth:config": "playwright test --config=playwright.auth.config.ts",
    "test:e2e:auth:comprehensive": "playwright test tests/journeys/auth-rbac-comprehensive.spec.ts --config=playwright.auth-simple.config.ts",
    "test:e2e:auth:all": "playwright test tests/journeys/auth-rbac*.spec.ts --config=playwright.auth-simple.config.ts",
    "scan": "node ./packages/eslint-config/scanner.js",
    "scan:strict": "node ./packages/eslint-config/scanner.js --strict",
    "scan:tokens": "node ./packages/eslint-config/scanner.js --tokens",
    "scan:components": "node ./packages/eslint-config/scanner.js --components",
    "scan:a11y": "node ./packages/eslint-config/scanner.js --a11y",
    "scan:fix": "node ./packages/eslint-config/scanner.js --fix",
    "scan:compliance": "node ./scripts/scan-compliance.mjs",
    "scan:compliance:json": "node ./scripts/scan-compliance.mjs --json",
    "scan:compliance:strict": "node ./scripts/scan-compliance.mjs --strict",
    "scan:all": "pnpm scan && pnpm scan:compliance",
    "lint:contracts": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/contract-parity.test.ts src/__tests__/rfc7807.test.ts",
    "test:contracts": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/contract-parity.test.ts",
    "test:rfc7807": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/rfc7807.test.ts",
    "test:sdk": "pnpm --filter @digilist/client-sdk test",
    "test:sdk:all": "pnpm --filter @digilist/client-sdk test -- --run",
    "test:sdk:authz": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/authz.service.test.ts",
    "test:sdk:api-error": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/api-error.test.ts",
    "test:sdk:fetch": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/fetch-client.test.ts",
    "test:sdk:terminology": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/terminology-compliance.test.ts",
    "test:sdk:exports": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/sdk-exports.test.ts",
    "test:sdk:hooks": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/hooks-integration.test.ts",
    "test:sdk:services": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/service-coverage.test.ts",
    "test:sdk:integration": "pnpm --filter @digilist/client-sdk test -- --run src/__tests__/integration/",
    "test:e2e": "npx playwright test",
    "test:e2e:auth": "npx playwright test e2e/auth.spec.ts",
    "test:e2e:booking": "npx playwright test e2e/booking-flow.spec.ts",
    "test:e2e:a11y": "npx playwright test e2e/accessibility.spec.ts",
    "test:e2e:security": "npx playwright test e2e/security.spec.ts",
    "test:e2e:perf": "npx playwright test e2e/performance.spec.ts",
    "test:all": "pnpm test:sdk:all && pnpm test:e2e",
    "test:e2e:stories": "npx playwright test e2e/stories/",
    "test:e2e:scenarios": "npx playwright test e2e/scenarios/",
    "test:e2e:real-world": "npx playwright test e2e/scenarios/real-world-scenarios.spec.ts",
    "test:rental-objects": "vitest run --run apps/backoffice/src/features/rental-objects",
    "test:rental-objects:coverage": "vitest run --coverage -- apps/backoffice/src/features/rental-objects",
    "test:rental-objects:performance": "vitest run --run apps/backoffice/src/features/rental-objects/__tests__/performance",
    "test:rental-objects:security": "vitest run --run apps/backoffice/src/features/rental-objects/__tests__/security",
    "test:rental-objects:scenarios": "vitest run --run apps/backoffice/src/features/rental-objects/__tests__/scenarios",
    "test:rental-objects:e2e": "playwright test e2e/rental-objects*.spec.ts e2e/scenarios/rental-objects-real-world.spec.ts",
    "test:rental-objects:all": "pnpm test:rental-objects && pnpm test:rental-objects:performance && pnpm test:rental-objects:security && pnpm test:rental-objects:scenarios",
    "test:e2e:edge-cases": "npx playwright test e2e/scenarios/edge-cases.spec.ts",
    "test:e2e:multi-user": "npx playwright test e2e/scenarios/multi-user.spec.ts",
    "test:e2e:data-integrity": "npx playwright test e2e/scenarios/data-integrity.spec.ts",
    "test:full": "pnpm test:sdk:all && pnpm test:e2e:stories && pnpm test:e2e:scenarios",
    "tokens:create": "npx @digdir/designsystemet tokens create --config designsystemet.config.json",
    "tokens:build": "npx @digdir/designsystemet tokens build --tokens ./packages/ds-themes/generated --out-dir ./packages/ds-themes/generated",
    "deploy:web": "./scripts/deploy.sh web",
    "deploy:backoffice": "./scripts/deploy.sh backoffice",
    "deploy:minside": "./scripts/deploy.sh minside",
    "deploy:all": "./scripts/deploy.sh all",
    "deploy:ssl": "./scripts/setup-ssl.sh"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "1.9.0",
    "@digdir/designsystemet-react": "^1.9.0",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.0.17",
    "axe-core": "^4.11.1",
    "eslint": "^9.10.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.3.3",
    "puppeteer": "^24.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17",
    "yaml": "^2.7.1",
    "zod": "^3.23.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@tanstack/react-query": "^5.62.16",
      "esbuild": "^0.27.2"
    }
  },
  "dependencies": {
    "js-cookie": "^3.0.5"
  }
}
