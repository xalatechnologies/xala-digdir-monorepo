{
  "name": "xala-digdir-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier -w .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "scan": "node ./packages/eslint-config/scanner.js",
    "scan:strict": "node ./packages/eslint-config/scanner.js --strict",
    "scan:tokens": "node ./packages/eslint-config/scanner.js --tokens",
    "scan:components": "node ./packages/eslint-config/scanner.js --components",
    "scan:a11y": "node ./packages/eslint-config/scanner.js --a11y",
    "scan:fix": "node ./packages/eslint-config/scanner.js --fix",
    "scan:compliance": "node ./scripts/scan-compliance.mjs",
    "scan:compliance:json": "node ./scripts/scan-compliance.mjs --json",
    "scan:compliance:strict": "node ./scripts/scan-compliance.mjs --strict",
    "scan:all": "pnpm scan && pnpm scan:compliance",
    "tokens:create": "npx @digdir/designsystemet tokens create --config designsystemet.config.json",
    "tokens:build": "npx @digdir/designsystemet tokens build --tokens ./packages/ds-themes/generated --out-dir ./packages/ds-themes/generated",
    "deploy:web": "./scripts/deploy.sh web",
    "deploy:backoffice": "./scripts/deploy.sh backoffice",
    "deploy:minside": "./scripts/deploy.sh minside",
    "deploy:all": "./scripts/deploy.sh all",
    "deploy:ssl": "./scripts/setup-ssl.sh"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "1.9.0",
    "@digdir/designsystemet-react": "^1.9.0",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "axe-core": "^4.11.1",
    "eslint": "^9.10.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.3.3",
    "puppeteer": "^24.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@tanstack/react-query": "^5.62.16"
    }
  }
}
